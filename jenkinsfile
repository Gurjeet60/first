pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        IMAGE_NAME      = "gurjeet12/laravel_app"
        IMAGE_TAG       = "v${BUILD_NUMBER}"
        NAMESPACE       = "laravel"
        DOCKER_COMPOSE  = "docker compose"
    }

    stages {

        /*
        ============================================================
        STAGE 1 : CHECKOUT SOURCE
        ============================================================
        */

        stage('Checkout Source') {

            steps {

                cleanWs()

                echo "========== CHECKOUT SOURCE =========="

                git(
                    branch: 'master',
                    credentialsId: 'github-pat',
                    url: 'https://github.com/Gurjeet60/first.git'
                )

                sh '''
                    set -e

                    echo "Latest Commit"

                    git log --oneline -1
                '''
            }
        }

        /*
        ============================================================
        STAGE 2 : PREPARE ENVIRONMENT
        ============================================================
        */

        stage('Prepare Environment') {

            steps {

                echo "========== PREPARE ENVIRONMENT =========="

                sh '''
                    set -e
                    cp -f .env.example .env
        
                    # Generate a real Laravel-compatible APP_KEY BEFORE the image is built
                    APP_KEY="base64:$(openssl rand -base64 32)"
                    sed -i "s|^APP_KEY=.*|APP_KEY=${APP_KEY}|" .env
        
                    php -r "file_exists('.env') || exit(1);"
                    echo ".env file created with APP_KEY successfully."
                    grep APP_KEY .env
                '''
            }
        }

        /*
        ============================================================
        STAGE 3 : BUILD DOCKER IMAGE
        ============================================================
        */

        stage('Build Docker Image') {

            steps {

                echo "========== BUILD DOCKER IMAGE =========="

                sh '''
                    set -e

                    ${DOCKER_COMPOSE} build

                    docker images

                    docker tag first-laravel_app:latest gurjeet12/laravel_app:v${BUILD_NUMBER}

                    docker tag first-laravel_app:latest gurjeet12/laravel_app:latest

                    echo "Docker image created successfully."  
                '''
            }
        }

        /*
        ============================================================
        STAGE 4 : START CONTAINERS & RUN TESTS
        ============================================================
        */

        stage('Start Containers & Run Tests') {

            steps {

                echo "========== START CONTAINERS =========="

                sh '''
                    set -e

                    ${DOCKER_COMPOSE} up -d

                    echo "Waiting for Laravel container..."

                    until ${DOCKER_COMPOSE} ps | grep -q "laravel_app.*Up"
                    do
                        sleep 5
                    done

                    echo "Installing Composer Packages..."

                    ${DOCKER_COMPOSE} exec -T laravel_app \
                        composer install \
                        --no-interaction \
                        --prefer-dist \
                        --optimize-autoloader

                    echo "Generating APP_KEY..."

                   ${DOCKER_COMPOSE} exec -T laravel_app php artisan key:generate --force

                   APP_KEY=$(${DOCKER_COMPOSE} exec -T laravel_app sh -c "grep '^APP_KEY=' .env | cut -d= -f2-")
                    
                   echo "APP_KEY=$APP_KEY"

                   
                   
                   ${DOCKER_COMPOSE} exec -T laravel_app cat bootstrap/cache/config.php 2>&1 | head -5
                   ${DOCKER_COMPOSE} exec -T laravel_app whoami
                   ${DOCKER_COMPOSE} exec -T laravel_app ls -la .env

                    ${DOCKER_COMPOSE} exec -T laravel_app \
                        php artisan storage:link || true

                    ${DOCKER_COMPOSE} exec -T laravel_app \
                        php artisan optimize:clear

                    ${DOCKER_COMPOSE} exec -T laravel_app \
                        php artisan migrate --force

                    ${DOCKER_COMPOSE} exec -T laravel_app \
                        php artisan db:seed --force
                        
                    ${DOCKER_COMPOSE} exec -T laravel_app bash -c "
                    mkdir -p storage/logs &&
                    touch storage/logs/laravel.log &&
                    chown -R www-data:www-data storage bootstrap/cache &&
                    chmod -R 775 storage bootstrap/cache
                    "

                    if ${DOCKER_COMPOSE} exec -T laravel_app test -d tests
                    then
                        echo "Running Laravel Tests..."

                        ${DOCKER_COMPOSE} exec -T laravel_app \
                            php artisan test
                    else
                        echo "No test suite found. Skipping tests."
                    fi

                    echo "Build & Test completed successfully."
                '''
            }
        }
        
                /*
        ============================================================
        STAGE 5 : PUSH DOCKER IMAGE
        ============================================================
        */

        stage('Push Docker Image') {

            steps {

                echo "========== PUSH DOCKER IMAGE =========="

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dokerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "$DOCKER_TOKEN" | docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}

                        docker push ${IMAGE_NAME}:latest

                        docker logout

                        echo "Docker image pushed successfully."
                    '''
                }
            }
        }
        
           /*
        ============================================================
        STAGE 6 : Ensure Minikube Running
        ============================================================
        */
        
        
                 stage('Ensure Minikube Running') {
                        steps {
                            sh '''
                                set -e
                                export KUBECONFIG=/var/lib/jenkins/.kube/config
                                if ! minikube status | grep -q "host: Running"; then
                                    echo "Minikube not running, starting it..."
                                    minikube start --driver=docker
                                    sleep 5
                                else
                                    echo "Minikube already running."
                                fi
                                kubectl get nodes
                            '''
                        }
                    }

        /*
        ============================================================
        STAGE 7 : DEPLOY TO KUBERNETES
        ============================================================
        */

        stage('Deploy to Kubernetes') {

            steps {

                echo "========== DEPLOY TO KUBERNETES =========="

                sh '''
                    set -e
                    export KUBECONFIG=/var/lib/jenkins/.kube/config
                    kubectl config use-context minikube
        
                    helm upgrade --install laravel ./Helm/Laracoffee \
                      -n laravel \
                      --create-namespace \
                      --set image.tag=v179 \
                      --set-string appKey="base64:YOUR_APP_KEY"
                    
                   echo "Deployment completed successfully."
                    
                '''
            }
        }

        /*
        ============================================================
        STAGE 8 : VERIFY DEPLOYMENT
        ============================================================
        */

        stage('Verify Deployment') {

            steps {

                echo "========== VERIFY DEPLOYMENT =========="

                sh '''
                    set -e

                    kubectl rollout status deployment/laravel-app \
                     -n ${NAMESPACE}  --timeout=300s 

                    kubectl get pods -n ${NAMESPACE}

                    kubectl get svc -n ${NAMESPACE}

                    kubectl get deployment -n ${NAMESPACE}
                '''
            }
        }

        /*
        ============================================================
        STAGE 9 : APPLICATION HEALTH CHECK
        ============================================================
        */

        stage('Application Health Check') {

            steps {

                echo "========== APPLICATION HEALTH CHECK =========="

                  sh '''
                    set -e
                    export KUBECONFIG=/var/lib/jenkins/.kube/config
        
                    POD=$(kubectl get pods -n laravel -l app=laravel-app \
                      --field-selector=status.phase=Running \
                      --sort-by=.metadata.creationTimestamp \
                      -o jsonpath='{.items[-1:].metadata.name}')
        
                    kubectl wait --for=condition=Ready pod/$POD -n laravel --timeout=120s
                    kubectl exec -n laravel $POD -- php artisan about
                    echo "Application is healthy."
                '''
            }
        }

    }   // ================= END OF STAGES ===================

    post {

        success {

            echo "========== DEPLOYMENT SUCCESSFUL =========="

            sh '''
                kubectl get pods -n ${NAMESPACE}

                kubectl get svc -n ${NAMESPACE}

                kubectl get deployment -n ${NAMESPACE}
            '''
        }

        failure {

            echo "========== DEPLOYMENT FAILED =========="

            sh '''
                kubectl get all -n ${NAMESPACE} || true

                POD=$(kubectl get pods \
                    -n ${NAMESPACE} \
                    -l app=laravel-app \
                    -o jsonpath="{.items[0].metadata.name}" 2>/dev/null || true)

                if [ -n "$POD" ]; then
                    kubectl logs $POD -n ${NAMESPACE} || true
                fi

                ${DOCKER_COMPOSE} logs || true

                kubectl rollout undo deployment/laravel-app \
                    -n ${NAMESPACE} || true
            '''
        }

        always {

            echo "========== CLEANUP =========="

            sh '''
                ${DOCKER_COMPOSE} down -v --remove-orphans || true

                docker container prune -f --filter "label!=io.x-k8s.kic.cluster=minikube" || true

                docker container prune -f || true
            '''

            cleanWs()
        }
    }

}   // ================= END OF PIPELINE ===================

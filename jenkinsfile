pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 40, unit: 'MINUTES')
    }

    environment {

        IMAGE_NAME = "gurjeet12/laravel_app"
        IMAGE_TAG  = "v${BUILD_NUMBER}"

        CHART_DIR  = "./Helm/Laracoffee"

        RELEASE_NAME = "laravel"
        NAMESPACE    = "laravel"

        DOCKER_CREDENTIALS = "dokerhub"
        GITHUB_CREDS       = "github-pat"

        KUBECONFIG = "/var/lib/jenkins/.kube/config"

        REGISTRY = "docker.io"

    }

    stages {

    /*--------------------------------------------------------------*/
    stage('Checkout Source') {

        steps {

            cleanWs()

            git(
                branch: 'master',
                credentialsId: env.GITHUB_CREDS,
                url: 'https://github.com/Gurjeet60/first.git'
            )

            sh '''
            echo "Repository Checked Out"

            git log --oneline -5
            '''

        }

    }

    /*--------------------------------------------------------------*/

    stage('Validate Environment') {

        steps {

            sh '''

            set -e

            echo "Checking Required Tools..."

            docker --version
            kubectl version --client
            helm version

            echo ""
            echo "Checking Kubernetes..."

            kubectl cluster-info

            echo ""
            echo "Checking Namespace..."

            kubectl get ns ${NAMESPACE} \
            || kubectl create namespace ${NAMESPACE}

            '''

        }

    }
    
    /*--------------------------------------------------------------*/
      stage('Install PHP Dependencies') {

                steps {
        
                    sh '''
        
                    composer install \
                        --no-dev \
                        --prefer-dist \
                        --optimize-autoloader \
                        --no-interaction
        
                    '''
        
                }
        
            }

    /*--------------------------------------------------------------*/

    

    stage('Prepare Laravel Environment') {

        steps {

            withCredentials([
                string(
                    credentialsId: 'laravel-app-key',
                    variable: 'APP_KEY'
                )
            ]) {

                sh '''

                set -e

                cp -f .env.example .env

                sed -i "s|^APP_KEY=.*|APP_KEY=${APP_KEY}|" .env

                php -r "file_exists('.env') || exit(1);"

                php artisan optimize:clear  || true
                
                '''

            }

        }

    }

    /*--------------------------------------------------------------*/
    
            stage('Build Docker Image') {
                        steps {
                            sh """
                                echo "Building Docker image..."
                    
                                docker build \
                                    -f docker/php/Dockerfile \
                                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                                    -t ${IMAGE_NAME}:latest \
                                    .
                    
                                docker images | grep laravel_app
                            """
                        }
                    }

  

    
    
            stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dokerhub') {

                        sh """
                            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest

                            docker push ${IMAGE_NAME}:${IMAGE_TAG}

                            docker push ${IMAGE_NAME}:latest
                        """
                    }
                }
            }
        }

               stage('Deploy to Kubernetes') {
            steps {
                script {
                    withCredentials([
                        string(credentialsId: 'laravel-app-key', variable: 'APP_KEY')
                    ]) {

                        sh """
                        export KUBECONFIG=/var/lib/jenkins/.kube/config

                        helm upgrade --install laravel ./Helm/Laracoffee \
                            --namespace laravel \
                            --create-namespace \
                            --wait \
                            --timeout 5m \
                            --atomic \
                            --set image.repository=${IMAGE_NAME} \
                            --set image.tag=${IMAGE_TAG} \
                            --set-string appKey="\$APP_KEY"
                        """
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                export KUBECONFIG=/var/lib/jenkins/.kube/config

                kubectl rollout status deployment/laravel-app \
                    -n laravel \
                    --timeout=180s

                kubectl get pods -n laravel
                kubectl get svc -n laravel
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                export KUBECONFIG=/var/lib/jenkins/.kube/config

                POD=$(kubectl get pod \
                    -n laravel \
                    -l app=laravel-app \
                    -o jsonpath='{.items[0].metadata.name}')

                kubectl exec -n laravel $POD -- php artisan about
                '''
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo 'Deployment Successful'
            echo '========================================'

            sh '''
            export KUBECONFIG=/var/lib/jenkins/.kube/config

            kubectl get all -n laravel

            echo ""
            echo "Application URL:"
            minikube service laravel-service \
                -n laravel \
                --url || true
            '''
        }

        failure {
            echo '========================================'
            echo 'Deployment Failed'
            echo '========================================'

            sh '''
            export KUBECONFIG=/var/lib/jenkins/.kube/config

            kubectl get pods -n laravel || true

            kubectl describe pods -n laravel || true

            kubectl logs \
                -n laravel \
                -l app=laravel-app \
                --tail=200 || true
            '''
        }

        always {

            echo 'Cleaning workspace...'

            cleanWs()

            sh '''
            docker image prune -f || true
            docker container prune -f || true
            '''
        }
    }
}
